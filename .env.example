# Entorno de ejecución de Node: development, test o production.
NODE_ENV=development

# Puerto en el que escucha el api.
PUERTO=3000

# Zona horaria con la que se calcula el día operativo (nombre IANA).
ZONA_HORARIA=America/Bogota

# Hora a la que empieza el día operativo, en formato HH:mm.
INICIO_DIA_OPERATIVO=06:00

# Lector de placas activo: simulado, manual o http (servicio lpr).
LECTOR_PLACAS=simulado

# Fuente de detección de vehículos: simulado o mqtt (sensor ESP32).
FUENTE_SENSOR=simulado

# Controlador de la barrera: simulado (pantalla) o mqtt (servo ESP32).
CONTROLADOR_BARRERA=simulado

# Conexión a PostgreSQL. El host "db" solo existe dentro de Docker Compose.
URL_BASE_DATOS=postgresql://carq:carq@db:5432/carq

# Conexión a Redis (caché del pase vigente). El host "redis" es el de Compose.
URL_REDIS=redis://redis:6379

# Broker MQTT para el sensor y la barrera. El host "mqtt" es el de Compose.
URL_MQTT=mqtt://mqtt:1883

# Servicio lpr (OCR). Solo se usa si LECTOR_PLACAS=http.
URL_LPR=http://lpr:8000

# URL del web. Es el único origen que el api acepta por CORS.
URL_WEB=http://localhost:3000

# Secreto para firmar los JWT. Cambiarlo por un valor propio en tu .env.
JWT_SECRETO=cambiar-este-secreto

# Duración del token de sesión (por ejemplo 8h). Si se omite, vale 8h.
JWT_EXPIRACION=8h

# Solo para la CLI de migraciones corriendo en tu máquina (fuera de Docker).
# Si se omite, se usa URL_BASE_DATOS.
URL_BASE_DATOS_MIGRACIONES=postgresql://carq:carq@localhost:5432/carq